{
  "chunks": [
    {
      "id": "c1",
      "doc": "complaint.txt",
      "text": "On March 15, 2023, the plaintiff filed a complaint alleging the vendor knew about the defect prior to shipment.",
      "score": {
        "timeline": 0.592183675577402,
        "knowledge": 0.24023012811570563,
        "incentives": 0.6518469665336781
      },
      "against": 0.0734703821238065
    },
    {
      "id": "c2",
      "doc": "complaint.txt",
      "text": "The complaint states the product failed within 48 hours of installation at the client site.",
      "score": {
        "timeline": 0.24921103321022564,
        "knowledge": 0.42019380100310455,
        "incentives": 0.2690307853190671
      },
      "against": 0.16590396030240623
    },
    {
      "id": "c3",
      "doc": "complaint.txt",
      "text": "Plaintiff seeks damages for breach of contract and negligent misrepresentation.",
      "score": {
        "timeline": 0.493320626233841,
        "knowledge": 0.2715173433212414,
        "incentives": 0.7905188986060383
      },
      "against": 0.7561786552672081
    },
    {
      "id": "c4",
      "doc": "complaint.txt",
      "text": "Exhibit A attached to the complaint includes photographs of the damaged unit.",
      "score": {
        "timeline": 0.6158707792283056,
        "knowledge": 0.7181926918931947,
        "incentives": 0.550178478193348
      },
      "against": 0.15067475716221457
    },
    {
      "id": "c5",
      "doc": "vendor_email.txt",
      "text": "Email from sales director to factory dated Feb 28, 2023: \"Please expedite the remaining 200 units, quality checks optional.\"",
      "score": {
        "timeline": 0.3743547654412165,
        "knowledge": 0.5000952930160775,
        "incentives": 0.3018275889878602
      },
      "against": 0.03639929669680294
    },
    {
      "id": "c6",
      "doc": "vendor_email.txt",
      "text": "Reply from factory manager on March 1, 2023: \"We noticed an intermittent fault but can ship if you accept liability.\"",
      "score": {
        "timeline": 0.48372215870255736,
        "knowledge": 0.3081330262503591,
        "incentives": 0.26035079767182057
      },
      "against": 0.07194850046266094
    },
    {
      "id": "c7",
      "doc": "vendor_email.txt",
      "text": "Sales director responded March 1, 2023: \"Ship anyway, we need to hit quarterly target.\"",
      "score": {
        "timeline": 0.7815036304840786,
        "knowledge": 0.20708273234249702,
        "incentives": 0.24848539373673978
      },
      "against": 0.1374862456501243
    },
    {
      "id": "c8",
      "doc": "vendor_email.txt",
      "text": "Follow-up email March 5, 2023: \"Customer reporting failures, keep this thread internal only.\"",
      "score": {
        "timeline": 0.6035903927895194,
        "knowledge": 0.2203938593600936,
        "incentives": 0.7986084241169438
      },
      "against": 0.033772143073674994
    },
    {
      "id": "c9",
      "doc": "inspection_report.txt",
      "text": "Independent inspector visited the site on March 20, 2023 and documented a failed capacitor.",
      "score": {
        "timeline": 0.41509336497357335,
        "knowledge": 0.7730992818911646,
        "incentives": 0.34002601494857343
      },
      "against": 0.21582928244878477
    },
    {
      "id": "c10",
      "doc": "inspection_report.txt",
      "text": "The report concludes the defect was present at the time of manufacture, not caused by installation.",
      "score": {
        "timeline": 0.38226241938181393,
        "knowledge": 0.48750044534120496,
        "incentives": 0.3044385749565498
      },
      "against": 0.2181174141451799
    },
    {
      "id": "c11",
      "doc": "inspection_report.txt",
      "text": "Thermal imaging shows abnormal heat signatures consistent with a pre-existing electrical fault.",
      "score": {
        "timeline": 0.6145319295703437,
        "knowledge": 0.6414023909703914,
        "incentives": 0.5821254266928059
      },
      "against": 0.16060227186909223
    },
    {
      "id": "c12",
      "doc": "inspection_report.txt",
      "text": "Inspector notes: \"This condition could only develop over weeks, not two days.\"",
      "score": {
        "timeline": 0.6116438429555904,
        "knowledge": 0.6905786015073823,
        "incentives": 0.6816829467555628
      },
      "against": 0.11205141758897681
    },
    {
      "id": "c13",
      "doc": "witness_stmt.txt",
      "text": "Site engineer testified the unit emitted a burning smell immediately after power-on.",
      "score": {
        "timeline": 0.43004148611076776,
        "knowledge": 0.23430689809126756,
        "incentives": 0.6561272153902649
      },
      "against": 0.06862466683215775
    },
    {
      "id": "c14",
      "doc": "witness_stmt.txt",
      "text": "The engineer stated no other equipment on the same circuit experienced any problems.",
      "score": {
        "timeline": 0.4820829600991621,
        "knowledge": 0.6499536506418577,
        "incentives": 0.799604693927517
      },
      "against": 0.14359298116509422
    },
    {
      "id": "c15",
      "doc": "witness_stmt.txt",
      "text": "Witness recalled a conversation on March 2, 2023 where the vendor promised \"thorough testing.\"",
      "score": {
        "timeline": 0.30472460456800565,
        "knowledge": 0.2831836313071804,
        "incentives": 0.6972302574551658
      },
      "against": 0.09465930769204627
    },
    {
      "id": "c16",
      "doc": "witness_stmt.txt",
      "text": "Engineer also saw an internal email mentioning \"skip QC\" but could not recall the sender name.",
      "score": {
        "timeline": 0.5173793036586427,
        "knowledge": 0.4498576216075186,
        "incentives": 0.3780053840991585
      },
      "against": 0.02183364424164944
    },
    {
      "id": "c17",
      "doc": "internal_memo.txt",
      "text": "Memo from CFO dated March 4, 2023: \"Missing Q1 revenue target will trigger covenant review.\"",
      "score": {
        "timeline": 0.6429636734359674,
        "knowledge": 0.7032230715047891,
        "incentives": 0.7687058160837559
      },
      "against": 0.29527578441163904
    },
    {
      "id": "c18",
      "doc": "internal_memo.txt",
      "text": "The memo recommends shipping all pending orders before quarter end to improve cash flow.",
      "score": {
        "timeline": 0.671476009515221,
        "knowledge": 0.41298609301653344,
        "incentives": 0.2548877609749935
      },
      "against": 0.10269779683896724
    },
    {
      "id": "c19",
      "doc": "internal_memo.txt",
      "text": "Risk officer annotated the memo: \"Accelerated shipping may increase warranty exposure.\"",
      "score": {
        "timeline": 0.3398881179536516,
        "knowledge": 0.3799987646071119,
        "incentives": 0.5787682418629843
      },
      "against": 0.01857093391574266
    },
    {
      "id": "c20",
      "doc": "internal_memo.txt",
      "text": "Another note on March 6, 2023: \"Do not document the QC waiver in customer-facing materials.\"",
      "score": {
        "timeline": 0.5875948644630687,
        "knowledge": 0.7010782359067418,
        "incentives": 0.4628350259794875
      },
      "against": 0.0323124197565991
    }
  ],
